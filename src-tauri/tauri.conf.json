{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "factory",
  "version": "0.6.2",
  "identifier": "com.freddyjd.gitfactory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "factory",
        "decorations": false,
        "width": 1100,
        "height": 760,
        "minWidth": 600,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/FreddyJD/factory/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NjQ3QUNGNzUyQkU1NzQKUldSMDVTdDF6M3BrUmNyOTNaWEJvYUd1eE1NYVNoamxqNjNhdmRudktiWUtodXZRcENaYUhrNGoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
